project_domain: "example.com"
project_url: "https://example.com"
secret_key: "randomSecretKey12345"

server:
  host: "127.0.0.1"
  port: 8085
  read_timeout: 10
  write_timeout: 10
  max_header_bytes: 1048576

postgres:
  dbuser: exampleuser
  dbpass: examplepassword
  dbname: exampledb
  dbhost: "localhost:5432"
  max_conns: 10

redis:
  host: localhost
  port: 6379
  password: ""
  db: 0

# Book preview pipeline. Every key has a built-in default, so the whole
# section may be omitted; set it to re-tune the gates after a catalog
# re-measurement or to move the preview cache to its own Redis.
# preview:
#   redis:
#     host: ""        # empty = same host as the main redis above
#     port: 0         # 0 = same port as the main redis
#     password: ""    # empty = same password as the main redis
#     db: 3           # the preview's own DB number (never shared)
#   cache_ttl: 24h
#   build_timeout: 2m
#   max_concurrent_builds: 2
#   max_fb2_bytes: 67108864           # 64 MiB
#   max_binaries: 1500
#   max_prepared_image_bytes: 50331648 # 48 MiB

sessions:
  key: randomSessionKey12345
  refresh: randomRefreshKey12345

app:
  devel_mode: false
  cdn: "https://example.com"
  files_path: "/files/"
  users_path: "/users/"
  book_cdn_key: "randomBookCdnKey12345"
  posters_path: "/posters/"
  file_book_cdn: "https://example.com"
  mobi_conversion_dir: "/mobi/"

scanning:
  skip_duplicates: true
  enable_language_detection: true
  enable_openai_lang_detection: false
  openai_lang_detection_timeout: "5s"
  max_concurrent_files: 1
  batch_size: 50

email:
  from: "no-reply@example.com"
  user: "apikey"
  password: "randomApiKey12345"
  smtp_server: smtp.example.com:465

  # Which of the two sets below is sent. Both are always carried, so this is a
  # restart rather than a rewrite. Anything but ru or en is read as en.
  language: en

  # What this installation calls itself: the wordmark at the head of every
  # email, and the name in its signature and footer.
  product_name: "Example"

  # Every wording the emails use, per language. All of it is optional — what is
  # left out arrives in the wording the application ships with, in the language
  # chosen above, so an installation that sets none of this still sends a
  # complete email rather than one with an empty subject and a nameless button.
  #
  # Overriding one field leaves the rest alone: to change nothing but the
  # signature, write nothing but thanks.
  messages:
    en:
      registration:
        subject: "Activate your account"
        title: "Activate your account"
        message: "Press the button to confirm your address and sign in."
        button: "Activate"
        thanks: "Best regards, the Example team"
        link_fallback: "If the button doesn't work, copy this link into your browser:"
        footer: "You received this email because you registered on Example."
      reset:
        subject: "Reset your password"
        title: "Reset your password"
        message: "Press the button to choose a new password. The link is good for 90 minutes."
        button: "Choose a new password"
        thanks: "Best regards, the Example team"
        link_fallback: "If the button doesn't work, copy this link into your browser:"
        warning: "If you didn't ask to change your password, simply don't open the link — your password stays as it is."
        footer: "You received this email because a password reset was requested for your Example account."
    ru:
      registration:
        subject: "Активация аккаунта"
        title: "Активация аккаунта"
        message: "Нажмите кнопку, чтобы подтвердить адрес и войти."
        button: "Активировать"
        thanks: "С уважением, команда Example"
        link_fallback: "Если кнопка не работает, скопируйте эту ссылку в браузер:"
        footer: "Вы получили это письмо, потому что зарегистрировались на Example."
      reset:
        subject: "Сброс пароля"
        title: "Сброс пароля"
        message: "Нажмите кнопку, чтобы задать новый пароль. Ссылка действует 90 минут."
        button: "Задать новый пароль"
        thanks: "С уважением, команда Example"
        link_fallback: "Если кнопка не работает, скопируйте эту ссылку в браузер:"
        warning: "Если вы не запрашивали смену пароля, просто не открывайте ссылку — пароль останется прежним."
        footer: "Вы получили это письмо, потому что для вашего аккаунта на Example запросили смену пароля."

# Ways of supporting this instance, shown in the "Donate" dialog.
#
# The interface knows nothing about any particular one: each entry says how it
# wants to be shown, so adding a method is an edit here rather than to the
# frontend. Leave the list out entirely and no donate button appears at all —
# which is what anyone running their own copy should get until they say
# otherwise.
#
#   kind: address — something to copy, shown in full
#         card    — a payment card, drawn as one, digits grouped
#         link    — somewhere to go, shown as a button
#   link:         — an optional page to open alongside a value worth showing,
#                   such as a bank's transfer form beside a card number
#   qr:           — draw a scannable code for the value; worth it for a wallet
#                   address or a URL, not for a card number
donate:
  - id: bitcoin
    label: Bitcoin
    kind: address
    value: "bc1qexampleaddress"
    qr: true
  - id: card
    label: Card
    kind: card
    value: "0000000000000000"
    link: "https://example.com/transfer"
  - id: boosty
    label: Boosty
    kind: link
    value: "https://example.com/boosty"
