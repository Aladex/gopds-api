# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
/config.yaml
bin/*
# Generated by `make swagger` (swaggo/swag), imported by cmd/main.go
/docs/
/booksdump-frontend/.idea/
.idea
AGENTS.md

# Development database dumps pulled from production (never committed)
/.dumps/

# Agent worktrees and stray npx artefacts at the repository root
/.claude/
/node_modules/
/.lighthouseci/

# Incremental build state written by `tsc -b`
*.tsbuildinfo
